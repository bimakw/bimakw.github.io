---
const highlights = [
  { number: '7+', label: 'Years Experience' },
  { number: '100K+', label: 'Users Supported' },
  { number: '15+', label: 'OSS Contributions' },
  { number: '40%', label: 'Deployment Time Cut' },
];
---

<section id="about" class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="section-title text-center">About Me</h2>
    <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-2xl mx-auto">
      A brief introduction about who I am and what I do
    </p>

    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Text Content -->
      <div class="space-y-6">
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
          I'm a <span class="text-primary font-semibold">Senior Cloud Infrastructure Engineer</span> at PT. Indomarco Prismatama (Indomaret Group)
          operating production cloud platforms — GCP, Kubernetes (K3s/GKE), Terraform, HashiCorp Vault, and ArgoCD GitOps.
          This track has run parallel since 2021, continuation of the Technical Architect work area; full focus from July 2026 onward.
        </p>

        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
          I specialize in <span class="text-primary">Golang</span>,
          <span class="text-primary">HashiCorp Vault</span>, <span class="text-primary">Terraform</span>, and
          <span class="text-primary">cloud-native infrastructure</span>. Hands-on with hybrid cloud/on-premise setups,
          IAP-secured workloads, and observability stacks (Grafana + Prometheus).
        </p>

        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
          Previously held a Technical Lead title (2021-2026) across 4 engineering squads (Recruitment, Time Management, IRK, Course) — coordination role, closed July 2026 to focus on cloud. The cloud/DevOps track ran parallel throughout and continues now.
        </p>

        <!-- Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6">
          {highlights.map((item) => (
            <div class="text-center">
              <div class="text-2xl md:text-3xl font-bold gradient-text">{item.number}</div>
              <div class="text-gray-500 dark:text-gray-500 text-sm">{item.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Image/Visual -->
      <div class="relative">
        <div class="card p-8">
          <div class="space-y-4">
            <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400">
              <span class="w-3 h-3 rounded-full bg-red-500"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
              <span class="w-3 h-3 rounded-full bg-green-500"></span>
              <span class="ml-2 font-mono text-sm">about.json</span>
            </div>
            <pre class="text-sm font-mono overflow-x-auto"><code class="text-gray-700 dark:text-gray-300">{`{
  "name": "Gregorius Bima Kharisma Wicaksana",
  "role": "Senior Cloud Infrastructure Engineer",
  "company": "PT. Indomarco Prismatama",
  "location": "Jakarta, Indonesia",
  "experience": "7+ years",
  "focus": [
    "GCP / Kubernetes",
    "Terraform / Vault",
    "ArgoCD / GitOps",
    "Observability"
  ],
  "available_for": "Remote Opportunities"
}`}</code></pre>
          </div>
        </div>

        <!-- Decorative elements -->
        <div class="absolute -top-4 -right-4 w-24 h-24 bg-primary/20 rounded-full blur-2xl"></div>
        <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-secondary/20 rounded-full blur-2xl"></div>
      </div>
    </div>
  </div>
</section>
